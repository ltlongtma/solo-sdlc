# Every variable the app needs, with placeholder values only.
# This file IS committed; `.env` is not. Never paste a real key here — one commit and it is
# in history forever, and `security-reviewer` checks `git log --all -- '*.env*'` at phase 6.
#
# Format: NAME=<what it is, where to get it>

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=<connection string from your database dashboard>

# --- Auth ---
AUTH_SECRET=<generate: openssl rand -base64 32>

# --- Paid APIs (these are the ones that can cost you money if abused) ---
# ANTHROPIC_API_KEY=<console.anthropic.com — server-side only, never expose to the client>

# --- Client-visible values ---
# Anything reaching the browser must be explicitly marked as public by your framework's
# convention (e.g. NEXT_PUBLIC_*). If it is not marked, it must not be imported client-side.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
